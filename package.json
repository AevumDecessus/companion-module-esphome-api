{
	"name": "esphome-api",
	"version": "3.0.0",
	"description": "ESPHome client module for Companion",
	"keywords": [
		"esphome"
	],
	"homepage": "https://github.com/bitfocus/companion-module-esphome-api#readme",
	"main": "dist/index.js",
	"scripts": {
		"prepare": "husky install",
		"format": "prettier -w .",
		"postinstall": "husky",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-esphome-api.git"
	},
	"author": "Bradley Wehmeier <BradleyWehmeier@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-esphome-api/issues"
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@protobuf-ts/runtime": "^2.11.0",
		"@protobuf-ts/runtime-rpc": "^2.11.0",
		"corepack": "^0.36.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@protobuf-ts/plugin": "^2.4.0",
		"@types/node": "^22.20.5",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
